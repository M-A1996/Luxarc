# Copy to ".env" and fill in. Every default is the most private / free option.

# ===== director brain (words -> render settings). TEXT ONLY leaves. =====
LLM_MODE=cloud                       # cloud = Groq llama-3 (free tier) | local = Ollama
GROQ_API_KEY=                # free key: https://console.groq.com  (also: pip install langchain-groq)
GROQ_MODEL=openai/gpt-oss-20b
OLLAMA_TEXT_MODEL=qwen2.5            # used if LLM_MODE=local

# ===== vision critic (looks at the render). Default LOCAL so the render never leaves. =====
VISION_MODE=local                    # local = Ollama vision (private) | cloud = Groq vision (render leaves!)
OLLAMA_VISION_MODEL=llava            # e.g. llava or llama3.2-vision (ollama pull it)
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# ===== renderer (diffusion + ControlNet). Groq CANNOT render — pick one below. =====
RENDER_PROVIDER=hf                   # hf | fal | local
RENDER_FALLBACK=local                # if the primary is rate-limited/fails, fall back here (local | none)
HF_API_KEY=                    # free tier: https://huggingface.co/settings/tokens
HF_RENDER_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# FAL_API_KEY=                       # https://fal.ai  (free credits then paid)
# FAL_RENDER_MODEL=fal-ai/sdxl-controlnet-union
# LOCAL_BASE_MODEL=stabilityai/stable-diffusion-xl-base-1.0
# LOCAL_CONTROLNET=diffusers/controlnet-canny-sdxl-1.0

# ===== structure map: what gets sent instead of the real image =====
STRUCTURE_TYPE=line                  # line (Canny, free/local) | depth (needs a local depth model)

# ===== privacy knob #1: blur identifying marks before mapping =====
REDACT_TEXT=1                        # 1 = OCR-blur titles/logos/addresses  (needs Tesseract)

# ===== self-correcting loop =====
MAX_REFINES=2                        # extra re-renders if the critic isn't happy
MIN_SCORE=7                          # accept a render scoring >= this (0-10)
